# ── Dependencies ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ── Environment & secrets ──
.env
.env.*

# ── Docker files (no need inside the image) ──
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# ── Version control ──
.git/
.gitignore

# ── IDE & OS artifacts ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs & coverage ──
logs/
*.log
coverage/
.nyc_output/

# ── Tests (not needed in production image) ──
tests/
__mocks__/
jest.config.js

# ── Docs & config not needed at runtime ──
README.md
Readme.md
render.yaml
eslint.config.js
.prettierrc*
*.md